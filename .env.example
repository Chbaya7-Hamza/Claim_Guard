# Copy this file to .env and fill in your own values. Never commit .env.
# NVIDIA NIM API key — https://build.nvidia.com (used by src/llm_adapter.py's
# NvidiaExplanationProvider for the bounded AI explanation capability).
NVIDIA_API_KEY=

# Optional: override the NIM chat-completions model (defaults to a sane
# instruction-tuned model in code if unset).
NVIDIA_MODEL=
